BOT_TOKEN=токен_от_BotFather
ANTHROPIC_API_KEY=твой_ключ_anthropic_или_openrouter
DATABASE_URL=postgresql+asyncpg://talking_bot:talking_bot@localhost:5432/talking_bot
LLM_MODEL=anthropic/claude-sonnet-4.6

# Нужен, только если api.telegram.org заблокирован у провайдера сервера.
# PROXY_URL=socks5://127.0.0.1:1080

# Супергруппа с темами (Topics/Forum), куда бот кладёт по теме на заказчика.
# Id обычно вида -1001234567890. Пусто — только личка с ботом.
# CONTROL_CHAT_ID=-1001234567890
